package components

import "github.com/denkhaus/templ-router/pkg/router/i18n"
import "github.com/denkhaus/templ-router/pkg/router/metadata"

templ Footer() {
	<footer class="bg-gray-800 text-white p-4 mt-8">
		<div class="container mx-auto text-center">
			<p>{ i18n.T(ctx, "footer_copyright") }</p>
			<div class="flex justify-center space-x-4 mt-2 text-sm">
				<a href="/privacy" class="hover:underline">{ i18n.T(ctx, "footer_privacy") }</a>
				<span>|</span>
				<a href="/terms" class="hover:underline">{ i18n.T(ctx, "footer_terms") }</a>
				<span>|</span>
				<a href={ "mailto:" + metadata.M(ctx, "company_email") } class="hover:underline">{ i18n.T(ctx, "footer_contact") }</a>
			</div>
			<div class="mt-2 text-xs text-gray-400">
				{ metadata.M(ctx, "company_name") } - v{ metadata.M(ctx, "version") }
			</div>
		</div>
	</footer>
}
