package components

import (
	"github.com/denkhaus/templ-router/demo/app/components"
	"github.com/denkhaus/templ-router/pkg/router/i18n"
	"github.com/denkhaus/templ-router/pkg/router/metadata"
)

// This page demonstrates the i18n issue with nested components
templ Page() {
	<div class="max-w-4xl mx-auto p-6">
		<div class="bg-blue-50 border-2 border-blue-300 p-6 mb-6">
			<h1 class="text-2xl font-bold text-blue-800">{ i18n.T(ctx, "page_title") }</h1>
			<p class="text-blue-700">{ i18n.T(ctx, "page_description") }</p>
			<div class="text-sm text-blue-600 mt-2">
				<p>Page debug info:</p>
				<p>- Current Locale: { i18n.GetCurrentLocale(ctx) }</p>
				<p>- Current Template: { i18n.GetCurrentTemplate(ctx) }</p>
				<p>- Page Metadata: { metadata.M(ctx, "page_data") }</p>
			</div>
		</div>

		<h2 class="text-xl font-semibold text-gray-800 mb-4">Embedded Components Test</h2>

		<!-- This component should work correctly - embedded directly in layout -->
		<div class="mb-6">
			<h3 class="text-lg font-semibold text-gray-700">Direct Footer Component (should work):</h3>
			@components.Footer()
		</div>

		<!-- This component demonstrates the issue - embedded in page -->
		<div class="mb-6">
			<h3 class="text-lg font-semibold text-gray-700">Nested Test Component (likely broken):</h3>
			@components.TestNestedComponent()
		</div>

		<!-- Test component within component -->
		<div class="mb-6">
			<h3 class="text-lg font-semibold text-gray-700">Test Component within Test Component:</h3>
			@components.TestNestedComponent()
		</div>

		<div class="bg-yellow-50 border-2 border-yellow-300 p-4">
			<h3 class="text-lg font-semibold text-yellow-800">Expected Behavior</h3>
			<ul class="list-disc ml-6 text-yellow-700">
				<li>Page should show English or German text based on URL (/en/test/components or /de/test/components)</li>
				<li>Footer should show its translations correctly (works because it's in layout)</li>
				<li>Nested Test Component should show its own translations (likely shows missing keys)</li>
				<li>All components should inherit the correct locale from the URL</li>
			</ul>
		</div>
	</div>
}